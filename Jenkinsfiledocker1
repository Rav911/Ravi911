pipeline
{
    agent any

    tools
    {
        maven 'Maven_3.9.9'
    }

    environment
    {
        buildNumber = "${BUILD_NUMBER}"
    }

    stages
    {
        stage('Git Checkout')
        {
          steps()
           {
             git branch: 'Devops', url: 'https://github.com/Rav911/Ravi911.git'
           }        
        }

        stage('Build Project')
        {
            steps()
            {
             sh 'mvn clean package'
            }
        }

        stage('Build Docker Image')
        {
            steps()
            {
                sh 'docker build -t ravi0911/local-image:${buildNumber} .'
            }
        }

        stage('Authenticate and Push Docker Image to Docker Hub Registry')
        {
            steps()
            {
                withCredentials([string(credentialsId: 'Docker_Hub_Password', variable: 'Docker_Hub_Password')])
                {
                    sh 'docker login -u ravi0911 -p ${Docker_Hub_Password}'
                }
                sh 'docker push ravi0911/local-image:${buildNumber}'
            }
        }

        stage('Remove Docker images Locally in Jenkins Server')
        {
            steps()
                {
                    sh 'docker rmi -f ravi0911/local-image:${buildNumber}'
                }

        }

        stage('Deploy Application to Deployment server')
        {
            steps()
                {
                    sshagent(['DeploymentServer_SSH']) 
                    {
                        sh "ssh -o StrictHostKeyChecking=no ubuntu@172.31.5.205 docker rm -f maven-container || true"
                        sh "ssh -o StrictHostKeyChecking=no ubuntu@172.31.5.205 docker run -d --name maven-container -p 8080:8080 ravi0911/local-image:${buildNumber}"
                    }
                }
            
        }
    }
}