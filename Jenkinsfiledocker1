pipeline {
    agent any

    tools {
        maven 'Maven_3.9.9'
    }

    stages {

        stage('Git Checkout') {
            steps {
                git branch: 'Devops', url: 'https://github.com/Rav911/Ravi911.git'
            }
        }

        stage('Build Project') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh """
                docker build -t ravi911/local-image:${BUILD_NUMBER} .
                """
            }
        }

        stage('Authenticate and Push Docker Image to Docker Hub Registry') {
            steps {
                withCredentials([string(credentialsId: 'Docker_Hub_Password', variable: 'DOCKER_PASS')]) {
                    sh """
                    echo "$DOCKER_PASS" | docker login -u ravi911 --password-stdin
                    docker push ravi911/local-image:${BUILD_NUMBER}
                    """
                }
            }
        }
    }
}
